# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA PORWARE CAI (PRODUCCIÓN Y DESARROLLO)
# ==============================================================================
# Copie este archivo a `.env` en la raíz del proyecto antes de iniciar:
#   cp .env.example .env
# NUNCA suba el archivo `.env` ni los certificados TLS al repositorio Git.

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL 16
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CambiarPorClaveSeguraPostgres2026!
POSTGRES_DB=porware_cai
DATABASE_URL="postgresql://postgres:CambiarPorClaveSeguraPostgres2026!@localhost:5432/porware_cai?schema=public"

# ------------------------------------------------------------------------------
# 2. SERVIDOR BACKEND NESTJS Y SEGURIDAD CRIPTOGRÁFICA
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# Secreto para firma de sesiones JWT (Generar con: openssl rand -hex 32)
JWT_SECRET="reemplazar_con_cadena_aleatoria_de_al_menos_64_caracteres_hex"
JWT_EXPIRATION="12h"

# Secreto para firma HMAC-SHA256 de Pases QR en el Backend (Generar con: openssl rand -hex 32)
# Si se deja vacío, se deriva automáticamente de JWT_SECRET.
QR_HMAC_SECRET="reemplazar_con_secreto_exclusivo_para_firma_hmac_sha256_de_qr"

# Orígenes permitidos por CORS (separados por coma, sin espacios)
CORS_ORIGINS="https://localhost,https://cai.empresa.local"

# ------------------------------------------------------------------------------
# 3. CREDENCIALES INICIALES DE BOOTSTRAP (SEED DE PRODUCCIÓN)
# ------------------------------------------------------------------------------
# Contraseña inicial para crear el primer Administrador (Cédula: V-10000001 / admin@porware.com).
# Al iniciar sesión por primera vez, el sistema forzará el cambio de clave (debeCambiarClave=true).
INITIAL_ADMIN_PASSWORD="CambiarClaveAdminInicial2026!"

# Contraseña inicial opcional para crear el usuario Vigilante de Garita (Cédula: V-20000002 / garita@porware.com).
INITIAL_SECURITY_PASSWORD="CambiarClaveGaritaInicial2026!"

# ------------------------------------------------------------------------------
# 4. FRONTEND / CLIENTE MÓVIL CAPACITOR (OPCIONAL)
# ------------------------------------------------------------------------------
# En despliegue Docker con Nginx Reverse Proxy se usa por defecto "/api/v1".
# Para compilar la APK Android apuntando al servidor HTTPS de producción:
VITE_API_URL="https://cai.empresa.local/api/v1"

# ------------------------------------------------------------------------------
# 5. GUÍA RÁPIDA PARA GENERAR CERTIFICADOS TLS (HTTPS) SIN VERSIONARLOS
# ------------------------------------------------------------------------------
# Los certificados TLS se montan desde `./nginx/certs/cai.crt` y `./nginx/certs/cai.key`
# (ignorados en `.gitignore`). Para generarlos antes de levantar `docker-compose.prod.yml`:
#   - En Linux / macOS:  ./scripts/generate-ssl-certs.sh cai.empresa.local
#   - En Windows:        scripts\generate-ssl-certs.bat cai.empresa.local
