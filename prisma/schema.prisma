datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMINISTRADOR
  EMPLEADO
  SEGURIDAD
}

enum TipoIngreso {
  ENTRADA
  SALIDA
}

model Usuario {
  id        String   @id @default(uuid())
  cedula    String   @unique
  nombre    String
  apellido  String
  email     String   @unique
  password  String
  rol       Role     @default(EMPLEADO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitaciones Invitado[]  @relation("EmpleadoInvitante")
  registros    Historial[]
}

model Invitado {
  id          String   @id @default(uuid())
  cedula      String   @unique
  nombre      String
  apellido    String
  empresa     String?
  empleadoId  String
  empleado    Usuario  @relation("EmpleadoInvitante", fields: [empleadoId], references: [id])
  createdAt   DateTime @default(now())

  historial Historial[]
}

model Historial {
  id          String      @id @default(uuid())
  invitadoId  String?
  invitado    Invitado?   @relation(fields: [invitadoId], references: [id])
  usuarioId   String?
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id])
  tipo        TipoIngreso
  timestamp   DateTime    @default(now())
  observacion String?
}

model Noticia {
  id        String   @id @default(uuid())
  titulo    String
  contenido String
  createdAt DateTime @default(now())
}
