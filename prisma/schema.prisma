datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMINISTRADOR
  EMPLEADO
  SEGURIDAD
}

enum TipoIngreso {
  ENTRADA
  SALIDA
}

enum EstadoVisita {
  PENDIENTE
  AUTORIZADA
  FINALIZADA
  DENEGADA
  CANCELADA
}

enum EstadoEvento {
  BORRADOR
  ACTIVO
  CERRADO
  CANCELADO
}

enum EstadoEventoInvitado {
  PENDIENTE
  APROBADO
  RECHAZADO
  REVOCADO
}

enum OrigenEventoInvitado {
  ENLACE
  ANFITRION
  GARITA
}

model Usuario {
  id             String      @id @default(uuid())
  cedula         String      @unique
  nombre         String
  apellido       String
  email          String      @unique
  password       String
  rol            Role        @default(EMPLEADO)
  cargo          String?
  departamento   String?
  telefonoMovil  String?
  telefonoFijo   String?
  fotoUrl        String?
  bloqueado          Boolean     @default(false)
  motivoBloqueo      String?
  registroCompletado Boolean     @default(false)
  debeCambiarClave   Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  invitaciones       Invitado[]  @relation("EmpleadoInvitante")
  visitasAutorizadas Visita[]    @relation("VisitasAutorizadas")
  eventosOrganizados Evento[]    @relation("AnfitrionEvento")
  registros          Historial[] @relation("UsuarioAcceso")
  registrosOperados  Historial[] @relation("OperadorRegistro")
  auditorias         Auditoria[] @relation("AuditoriaUsuario")
}

model Invitado {
  id            String      @id @default(uuid())
  cedula        String      @unique
  nombre        String
  apellido      String
  empresa       String?
  placa         String?
  telefono      String?
  motivo        String?
  fotoUrl       String?
  bloqueado     Boolean     @default(false)
  motivoBloqueo String?
  eliminado     Boolean     @default(false)
  empleadoId    String
  empleado      Usuario     @relation("EmpleadoInvitante", fields: [empleadoId], references: [id])
  createdAt     DateTime    @default(now())

  visitas       Visita[]
  historial     Historial[]
  eventos       EventoInvitado[]
}

model Visita {
  id              String       @id @default(uuid())
  invitadoId      String
  invitado        Invitado     @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  empleadoId      String
  empleado        Usuario      @relation("VisitasAutorizadas", fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha           DateTime     @default(now())
  fechaExpiracion DateTime?
  motivo          String?
  placa           String?
  estado          EstadoVisita @default(AUTORIZADA)
  observacion     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  historial       Historial[]
  eventoInvitados EventoInvitado[]
}

model Evento {
  id                 String           @id @default(uuid())
  nombre             String
  descripcion        String?
  anfitrionId        String
  anfitrion          Usuario          @relation("AnfitrionEvento", fields: [anfitrionId], references: [id], onDelete: Cascade)
  inicio             DateTime
  fin                DateTime
  aforo              Int
  requiereAprobacion Boolean          @default(true)
  estado             EstadoEvento     @default(ACTIVO)
  codigoActivo       Boolean          @default(true)
  nonceCodigo        String           @default(uuid())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  invitados          EventoInvitado[]

  @@index([anfitrionId])
  @@index([estado])
  @@index([inicio, fin])
}

model EventoInvitado {
  id         String               @id @default(uuid())
  eventoId   String
  evento     Evento               @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  invitadoId String
  invitado   Invitado             @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  estado     EstadoEventoInvitado @default(PENDIENTE)
  origen     OrigenEventoInvitado @default(ENLACE)
  visitaId   String?
  visita     Visita?              @relation(fields: [visitaId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())

  @@unique([eventoId, invitadoId])
  @@index([eventoId])
  @@index([estado])
}

model Historial {
  id              String       @id @default(uuid())
  invitadoId      String?
  invitado        Invitado?    @relation(fields: [invitadoId], references: [id])
  usuarioId       String?
  usuario         Usuario?     @relation("UsuarioAcceso", fields: [usuarioId], references: [id])
  registradoPorId String?
  registradoPor   Usuario?     @relation("OperadorRegistro", fields: [registradoPorId], references: [id])
  visitaId        String?
  visita          Visita?      @relation(fields: [visitaId], references: [id])
  tipo            TipoIngreso
  timestamp       DateTime     @default(now())
  observacion     String?
}

model Noticia {
  id        String   @id @default(uuid())
  titulo    String
  contenido String
  imagenUrl String?
  createdAt DateTime @default(now())
}

model Auditoria {
  id         String   @id @default(uuid())
  usuarioId  String?
  usuario    Usuario? @relation("AuditoriaUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)
  accion     String
  entidad    String
  entidadId  String?
  detalles   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([accion])
  @@index([createdAt])
}

