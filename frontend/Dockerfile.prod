# ==============================================================================
# ETAPA 1: Compilación de la SPA React + Vite + TypeScript en Node 22 LTS
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==============================================================================
# ETAPA 2: Servidor Web Nginx con TLS / HTTPS
# ==============================================================================
FROM nginx:1.27-alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]

